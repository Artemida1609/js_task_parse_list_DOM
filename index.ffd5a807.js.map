"use strict";
// write code here
var list = document.body.querySelectorAll("li");
function getEmployees(employeesList) {
    var employees = [];
    for(var i = 0; i < employeesList.length; i++){
        var employeeName = employeesList[i].innerHTML.trim();
        var salary = parseInt(employeesList[i].getAttribute("data-salary").replace(/[$,]/g, ""));
        var position = employeesList[i].getAttribute("data-position");
        var age = employeesList[i].getAttribute("data-age");
        employees.push({
            employeeName: employeeName,
            position: position,
            salary: salary,
            age: age
        });
    }
    return employees;
}
function sortList(employeesList) {
    return employeesList.sort(function(a, b) {
        return b.salary - a.salary;
    });
}
var unsortedEmployees = getEmployees(list);
var sortedEmployees = sortList(unsortedEmployees);
for(var i = 0; i < sortedEmployees.length; i++)list[i].innerHTML = sortedEmployees[i].employeeName;

